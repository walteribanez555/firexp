# EditorConfig — https://editorconfig.org
root = true

[*]
charset                  = utf-8
end_of_line              = lf
indent_style             = space
indent_size              = 2
trim_trailing_whitespace = true
insert_final_newline     = true

[*.{ts,tsx,js,jsx,mjs,cjs}]
indent_size = 2

[*.json]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.sh]
indent_size              = 2
end_of_line              = lf

[Makefile]
indent_style = tab

[{package-lock.json,yarn.lock}]
indent_size              = unset
trim_trailing_whitespace = false
insert_final_newline     = false
