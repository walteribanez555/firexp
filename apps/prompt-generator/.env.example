NODE_ENV=development
PORT=3002

# AWS / Bedrock settings
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# Prompt generation mode: ai | random | static  (default: ai)
PROMPT_MODE=ai

# DynamoDB table for prompt cache
PROMPTS_TABLE=fire-hack-prompts

# AWS Secrets Manager secret ID (optional; used in production to pull credentials)
# SECRET_ID=arn:aws:secretsmanager:us-east-1:123456789012:secret:firexp/prompt-generator

# Prompt cache TTL in seconds (default: 86400 = 24 h)
# CACHE_TTL_SECONDS=86400

# Log level: debug | info | warn | error
# LOG_LEVEL=info
