NODE_ENV=development
PORT=3001
DEBUG=true

# Base origin of the content-api backend (DynamoDB-backed catalog source of truth).
# NOTE: base origin WITHOUT the /api/v1 prefix — the relay adds /api/v1 itself.
# When unset, relay falls back to bundled series/*.json files.
CONTENT_API_URL=http://localhost:3003

# Prompt generation mode:
#   static  — use the prompt from story.json as-is (default, no AWS needed)
#   random  — pick from template pool in kb/<storyId>.json (no AWS needed)
#   ai      — call Bedrock (Claude) to generate the prompt dynamically
PROMPT_MODE=random

# Required only when PROMPT_MODE=ai
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# Production only — allowed CORS origins (comma-separated)
# CORS_ORIGINS=https://your-domain.com

# ── Optional: Twitch chat → audience votes ────────────────────────────────────
# Turn a Twitch stream's chat into audience votes for a room. Anonymous,
# read-only (no oauth token needed). Set BOTH to auto-attach at startup, or
# leave unset and attach at runtime via:
#   POST /api/v1/rooms/:code/twitch  { "channel": "<twitch_channel>" }
# When unset the relay behaves exactly as today.
# Viewers vote by typing !a / !b / !c or !1 / !2 in chat (index into the
# current decision's options). Audience votes count toward the tally/winner
# but never re-profile flags and are never saved as viewer profiles.
# TWITCH_CHANNEL=your_twitch_channel
# TWITCH_ROOM=ABCD
