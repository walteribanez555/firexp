NODE_ENV=development
PORT=3001
DEBUG=true

# Base origin of the content-api backend (DynamoDB-backed catalog source of truth).
# NOTE: base origin WITHOUT the /api/v1 prefix — the relay adds /api/v1 itself.
# When unset, relay falls back to bundled series/*.json files.
CONTENT_API_URL=http://localhost:3003

# Prompt generation mode:
#   static  — use the prompt from story.json as-is (default, no AWS needed)
#   random  — pick from template pool in kb/<storyId>.json (no AWS needed)
#   ai      — call Bedrock (Claude) to generate the prompt dynamically
PROMPT_MODE=random

# Required only when PROMPT_MODE=ai
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# Production only — allowed CORS origins (comma-separated)
# CORS_ORIGINS=https://your-domain.com
