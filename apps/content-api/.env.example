NODE_ENV=development
PORT=3003

# DynamoDB connection
# Set DYNAMODB_ENDPOINT for local dev (DynamoDB Local); leave unset in production (uses real AWS).
DYNAMODB_ENDPOINT=http://localhost:8000
AWS_REGION=us-east-1

# DynamoDB table names
SERIES_TABLE=firexp-dev-series
EPISODES_TABLE=firexp-dev-episodes

# S3 bucket for video/image storage (required for presigned URL generation)
CONTENT_BUCKET=your-content-bucket-name

# CloudFront base URL for serving media (optional; if unset, S3 URLs are used directly)
# CDN_BASE=https://your-cloudfront-distribution.cloudfront.net

# Storage backend: 'dynamo' (default when DynamoDB env vars are present) or 'memory' (tests)
# STORAGE=dynamo

# Presigned URL TTL in seconds (default: 300)
# PRESIGN_TTL=300

# Log level: debug | info | warn | error
# LOG_LEVEL=info
